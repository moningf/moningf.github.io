---
import { Button, Collapse, Spoiler, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'
import ToolSection from '@/components/about/ToolSection.astro'

const headings = [
  { depth: 2, slug: 'hobbies', text: 'Hobbies' },
  { depth: 2, slug: 'tools', text: 'Tools' },
  { depth: 2, slug: 'social-networks', text: 'Social Networks' },
  { depth: 2, slug: 'gossips', text: 'Gossips' },
  { depth: 2, slug: 'about-blog', text: 'About Blog' }
]
---

<PageLayout title='About' {headings} comment>
  <p>Developer / Student</p>
  <p>
  正在努力学习，为求职做准备。
  想要成为一名优秀的程序员，喜欢研究新技术和分享知识。
  </p>
  <p> Motto: You only live once. </p>
  <!-- <Spoiler>这里可以夹私货，比如为什么要演奏春日影！</Spoiler> -->
  <!-- <Button title='Sponsor Me' class='w-fit' href='/projects#sponsorship' variant='ahead' /> -->

  {/* general-talk */}
  <h2 id='hobbies'>Hobbies</h2>
  <ul>
    <li>研究一些稀奇古怪的东西<Spoiler>为此经常懊恼浪费了好多时间</Spoiler></li>
      <li>Minecraft！好玩，爱玩</li>
  </ul>

  {/* tools */}
  <h2 id='tools'>Tools</h2>
  <p>目前使用的工具:</p>
  <ToolSection
    class='mb-5'
    title='Development'
    tools={[
      {
      name: 'IDEA',
      description: 'IDE',
      href: 'https://www.jetbrains.com/idea/',
      icon: import('@/assets/tools/intellij-idea.svg?raw')
      },
      {
      name: 'Neovim',
      description: 'IDE',
      href: 'https://neovim.io/',
      icon: import('@/assets/tools/neovim.svg?raw')
      },
      {
        name: 'VS Code',
        description: 'IDE',
        href: 'https://code.visualstudio.com/',
        icon: import('@/assets/tools/vscode.svg?raw')
      }
    ]}
  />

  <ToolSection
    class='mb-5'
    title='Productivity'
    tools={[
      {
        name: 'Zen-Browser',
        description: 'Browser',
        href: 'https://zen-browser.app/',
        icon: import('@/assets/tools/zen-browser.svg?raw')
      },
      {
        name: 'Chrome',
        description: 'Browser',
        href: 'https://www.google.com/chrome/',
        icon: import('@/assets/tools/chrome.svg?raw')
      },
      {
        name: '飞书',
        description: 'Note Taking',
        href: 'https://www.feishu.cn/',
        icon: import('@/assets/tools/feishu.svg?raw')
      },
      {
        name: 'Typora',
        description: 'Markdown Editor',
        href: 'https://typora.io/',
        icon: import('@/assets/tools/typora.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Environment'
    tools={[
      {
        name: 'Arch Linux',
        description: 'Primary OS · Lenovo Legion Y7000P',
        href: 'https://archlinux.org/',
        icon: import('@/assets/tools/archlinux.svg?raw')
      },
      {
        name: 'Windows 11',
        description: 'Dual Boot · Lenovo Legion Y7000P',
        href: 'https://www.microsoft.com/windows/windows-11',
        icon: import('@/assets/tools/windows11.svg?raw')
      }
    ]}
  />

  {/* social-networks */}
  <h2 id='social-networks'>Social Networks</h2>
  <p>
    你可以通过下面的链接找到我。
  </p>

  <Substats
    stats={[
      {
        platform: 'GitHub',
        icon: 'github',
        link: 'https://github.com/moningf',
        text: 'followers',
        api: 'github/moningf'
      },
      {
        platform: 'Zhihu',
        icon: 'zhihu',
        color: '#0084ff',
        link: 'https://www.zhihu.com/people/47-5-5-84',
        text: 'followers',
      },
      {
        platform: 'Bilibili',
        icon: 'bilibili',
        color: '#fb7299',
        link: 'https://space.bilibili.com/3546699316332613',
        text: 'followers',
      }
    ]}
  />

  {/* about-blog */}
  <h2 id='about-blog'>About Blog</h2>
  <p>博客的一些变化：</p>
  <Timeline
    events={[
      {
        date: '2026-09-16',
        content:
          '博客从 <a href="https://gohugo.io/" target="_blank">Hugo</a> 和 Blowfish 迁移到 <a href="https://astro.build/" target="_blank">Astro</a> 和 <a href="https://github.com/cworld1/astro-theme-pure" target="_blank">Astro Theme Pure</a>'
      },
      {
        date: '2026-09-17',
        content:
          '完成文章迁移和页面配置，并将博客部署到 <a href="https://vercel.com/" target="_blank">Vercel</a>'
      }
    ]}
  />

  <p> 本站的运行离不开以下开源项目和服务： </p>

  <ul>
    <li> 网站框架： <a href='https://astro.build/' target='_blank'>Astro</a> </li>
    <li> 博客主题： 
      <a href='https://github.com/cworld1/astro-theme-pure' target='_blank' > Astro Theme Pure </a> 
    </li>
    <li>
      网站托管： <a href='https://vercel.com/' target='_blank'>Vercel</a>
    </li>
    <li>
      评论系统： <a href='https://waline.js.org/' target='_blank'>Waline</a>
    </li>
    <li>
      评论数据库： <a href='https://neon.com/' target='_blank'>Neon</a>
    </li>
    <li>
      社交数据：
      <a
          href='https://github.com/spencerwooo/substats'
          target='_blank'
          >
          Substats
      </a>
    </li>
  </ul>
</PageLayout>
